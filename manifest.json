{
  "manifest_version": 3,
  "name": "Vocabulary Chrome Extension",
  "version": "0.13.0",
  "description": "Highlight một từ tiếng Anh để tra cứu định nghĩa nhanh ngay trên trang.",
  "action": {
    "default_title": "Vocabulary Lookup",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/runtimeServiceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/runtimeContentScript.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "declarativeNetRequest",
    "tts",
    "clipboardRead"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "src/rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://www.vocabulary.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://translate.google.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "Open Vocabulary lookup popup"
    }
  }
}